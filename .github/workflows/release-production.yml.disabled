# INACTIVE: approval rules, exact document IAM scope and backup evidence are prerequisites.
# When activated, keep this same .yml path on default staging and on main.
# Dispatch with ref main; dispatch on default staging must skip the promote job.
name: Promote production

on:
  push:
    branches: [main]
    paths: [deploy/production-release.json]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: vellum-deploy-production
  cancel-in-progress: false

jobs:
  promote:
    if: >-
      vars.VELLUM_CD_ENABLED == 'true' && github.ref == 'refs/heads/main' &&
      (vars.PRODUCTION_APPROVAL_MODE == 'environment' ||
      (vars.PRODUCTION_APPROVAL_MODE == 'manual' && github.event_name == 'workflow_dispatch'))
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    environment: production
    permissions:
      contents: read
      actions: read
      id-token: write
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Resolve approved staging artifact and compare tested source trees
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 deploy/cd/release.py resolve --output approved-release.json
      - uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd # v6.3.0
        with:
          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}
          allowed-account-ids: ${{ vars.AWS_ACCOUNT_ID }}
          role-duration-seconds: 1800
          role-session-name: vellum-production-${{ github.run_id }}
      - name: Promote exact digests through production-specific SSM document
        env:
          SSM_INSTANCE_ID: ${{ vars.SSM_INSTANCE_ID }}
          SSM_DOCUMENT_ARN: ${{ vars.SSM_DOCUMENT_ARN }}
          SSM_DOCUMENT_VERSION: ${{ vars.SSM_DOCUMENT_VERSION }}
          SSM_DOCUMENT_SHA256: ${{ vars.SSM_DOCUMENT_SHA256 }}
        run: python3 deploy/cd/release.py dispatch --environment production --manifest approved-release.json
