# Local development only. Copy to .env and replace JWT_SECRET before use.
# DB_PASSWORD matches the existing local Compose database default; do not use it in deployment.
PORT=8080
DB_HOST=postgres
DB_PORT=5432
DB_USER=vellum
DB_PASSWORD=password
DB_NAME=vellum
DB_SSLMODE=disable
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# Optional; defaults to the existing local frontend origin.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional listen interface; leave unset for Compose. Isolated tests use loopback.
# BIND_HOST=127.0.0.1
# Comma-separated CIDRs of reverse proxies allowed to supply X-Forwarded-For.
# Defaults to none: direct local requests ignore all proxy headers.
# For Docker, prefer Caddy's stable exact /32 or /128 address; otherwise use the
# exact `web` subnet with controlled membership. Never trust all private ranges.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Authentication rate limits (positive request count and Go duration).
# RATE_LIMIT_LOGIN_REQUESTS=10
# RATE_LIMIT_LOGIN_WINDOW=1m
# RATE_LIMIT_REGISTER_REQUESTS=5
# RATE_LIMIT_REGISTER_WINDOW=1h
# RATE_LIMIT_REFRESH_REQUESTS=30
# RATE_LIMIT_REFRESH_WINDOW=1m
# RATE_LIMIT_LOGOUT_REQUESTS=30
# RATE_LIMIT_LOGOUT_WINDOW=1m
# RATE_LIMIT_MAX_ENTRIES=10000
# RATE_LIMIT_SHARED_IP_MULTIPLIER=20
# When running Go directly on the host, set DB_HOST=localhost instead.

# Password recovery is disabled by default; never send real emails in tests.
PASSWORD_RESET_EMAIL_MODE=disabled
# Operator setup and environment isolation: deploy/PASSWORD-RESET.md
# APP_ENV=staging
# AWS_REGION=eu-west-2
# SES_FROM_ADDRESS=no-reply-staging@kacpergajdarski.com
# PASSWORD_RESET_FRONTEND_URL=https://staging.vellum.kacpergajdarski.com/reset-password
# PASSWORD_RESET_ALLOWED_RECIPIENTS=operator-controlled@example.com
# PASSWORD_RESET_TOKEN_TTL=20m
# PASSWORD_RESET_COOLDOWN=1m
# PASSWORD_RESET_QUEUE_SIZE=32
# PASSWORD_RESET_SEND_TIMEOUT=5s
# RATE_LIMIT_FORGOT_PASSWORD_REQUESTS=3
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW=1h
# RATE_LIMIT_RESET_PASSWORD_REQUESTS=10
# RATE_LIMIT_RESET_PASSWORD_WINDOW=1m
