{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test src/features/transactions/utils/activity.test.mjs tests/architecture.test.mjs tests/passwordRecovery.test.mjs",
    "test:finance": "node --test src/features/transactions/utils/activity.test.mjs",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:csp": "node scripts/run-e2e.mjs --csp-report-only && node scripts/run-e2e.mjs --csp-enforce",
    "test:e2e:check": "tsc -p tsconfig.e2e.json",
    "screenshots": "node scripts/run-e2e.mjs --capture-screenshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.20.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.3.5"
  }
}
