# syntax=docker/dockerfile:1
FROM node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS build

WORKDIR /src
# Patch bundled npm before using it to bootstrap the pinned pnpm version.
RUN npm install --global npm@11.21.1 \
    && npm install --global pnpm@10.34.8
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# Public build-time configuration only; use the current browser origin in both environments.
ENV VITE_API_BASE_URL=/
RUN pnpm build

FROM nginxinc/nginx-unprivileged:1.30.6-alpine3.24@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03 AS runtime

# This upstream digest predates these Alpine security fixes. Pin only the affected
# packages; unavailable revisions fail the build instead of silently changing it.
USER 0
RUN apk add --no-cache \
    brotli-libs=1.2.1-r0 \
    musl=1.2.6-r3 \
    musl-utils=1.2.6-r3 \
    zlib=1.3.2-r1

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -T 3 -O /dev/null http://127.0.0.1:8080/healthz || exit 1
# No startup template rewriting is needed; this also supports a read-only root filesystem.
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
