# Merge these site blocks into the EXISTING Caddy configuration manually.
# Caddy must already be attached to the external Docker network "web".
# Do not use handle_path: Go expects the /api prefix to be preserved.
# Forward auth preflights too; GET /login must still reach the SPA.
# Omitting OPTIONS can send it to Nginx's SPA fallback (HTML 405), not Gin.

vellum.kacpergajdarski.com {
	encode zstd gzip

	@recovery path /forgot-password /reset-password
	header @recovery {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	@api path /api /api/* /ping
	handle @api {
		reverse_proxy vellum-production-backend:8080
	}

	@auth {
		method POST OPTIONS
		path /register /login /refresh /logout /forgot-password /reset-password
	}
	handle @auth {
		reverse_proxy vellum-production-backend:8080
	}

	# GET /login and all other browser routes go to the SPA.
	handle {
		reverse_proxy vellum-production-frontend:8080
	}
}

staging.vellum.kacpergajdarski.com {
	encode zstd gzip

	@recovery path /forgot-password /reset-password
	header @recovery {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	@api path /api /api/* /ping
	handle @api {
		reverse_proxy vellum-staging-backend:8080
	}

	@auth {
		method POST OPTIONS
		path /register /login /refresh /logout /forgot-password /reset-password
	}
	handle @auth {
		reverse_proxy vellum-staging-backend:8080
	}

	handle {
		reverse_proxy vellum-staging-frontend:8080
	}
}
