# Copy to production.env (ignored), chmod 600, then fill every blank value.
# Keep the project name stable: changing it selects a different database volume.
COMPOSE_PROJECT_NAME=vellum-production
APP_ORIGIN=https://vellum.kacpergajdarski.com
# Local images initially. Later: ghcr.io/<owner>/vellum (lowercase owner).
IMAGE_PREFIX=vellum
# Full 40-character Git commit SHA used to build BOTH images; never use latest.
IMAGE_TAG=
DB_NAME=vellum_production
DB_USER=vellum_production
# Generate independently with: openssl rand -hex 32
DB_PASSWORD=
# Generate a DIFFERENT value with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h
