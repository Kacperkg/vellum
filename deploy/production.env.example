# Copy to production.env (ignored), chmod 600, then fill every blank value.
# Keep the project name stable: changing it selects a different database volume.
COMPOSE_PROJECT_NAME=vellum-production
APP_ORIGIN=https://vellum.kacpergajdarski.com
# Local images initially. Later: ghcr.io/<owner>/vellum (lowercase owner).
IMAGE_PREFIX=vellum
# Full 40-character Git commit SHA used to build BOTH images; never use latest.
IMAGE_TAG=
DB_NAME=vellum_production
DB_USER=vellum_production
# Generate independently with: openssl rand -hex 32
DB_PASSWORD=
# Generate a DIFFERENT value with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h
# Prefer Caddy's stable exact /32 or /128. Otherwise trust only the controlled web subnet.
# Subnet: docker network inspect web --format '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXY_CIDRS=

# Recovery is inert until the operator completes deploy/PASSWORD-RESET.md.
APP_ENV=production
AWS_REGION=eu-west-2
PASSWORD_RESET_EMAIL_MODE=disabled
SES_FROM_ADDRESS=no-reply@kacpergajdarski.com
PASSWORD_RESET_FRONTEND_URL=https://vellum.kacpergajdarski.com/reset-password
PASSWORD_RESET_TOKEN_TTL=20m
PASSWORD_RESET_COOLDOWN=1m
PASSWORD_RESET_QUEUE_SIZE=32
PASSWORD_RESET_SEND_TIMEOUT=5s
# Exact comma-separated recipient addresses; mandatory for staging SES mode.
PASSWORD_RESET_ALLOWED_RECIPIENTS=
RATE_LIMIT_FORGOT_PASSWORD_REQUESTS=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=1h
RATE_LIMIT_RESET_PASSWORD_REQUESTS=10
RATE_LIMIT_RESET_PASSWORD_WINDOW=1m
