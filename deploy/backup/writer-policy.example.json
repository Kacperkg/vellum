{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndVerifyBackupObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET/production/*",
        "arn:aws:s3:::REPLACE_BUCKET/staging/*"
      ]
    },
    {
      "Sid": "InspectExactBackupBucketForVersionedProducer",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketVersioning"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET"
    },
    {
      "Sid": "NotifyBackupFailure",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:eu-west-2:REPLACE_ACCOUNT_ID:REPLACE_TOPIC"
    }
  ]
}
