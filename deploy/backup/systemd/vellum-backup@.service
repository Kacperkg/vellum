[Unit]
Description=Vellum %i daily PostgreSQL backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/usr/local/lib/vellum-cd
ExecStart=/usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/root /usr/local/lib/vellum-cd/backup.sh %i
TimeoutStartSec=45min
TimeoutStopSec=20min
KillMode=control-group
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
