{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCompletionMarkers",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": {"StringEquals": {"s3:prefix": ["production/completed/", "staging/completed/"]}}
    },
    {
      "Sid": "VerifyCompletedBackups",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET/production/runs/*",
        "arn:aws:s3:::REPLACE_BUCKET/production/completed/*",
        "arn:aws:s3:::REPLACE_BUCKET/staging/runs/*",
        "arn:aws:s3:::REPLACE_BUCKET/staging/completed/*"
      ]
    },
    {
      "Sid": "InspectExactBackupBucketForSignedFreshness",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET"
    },
    {
      "Sid": "ReadSignedBackupMetadataVersions",
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET/production/runs/*.json",
        "arn:aws:s3:::REPLACE_BUCKET/production/completed/*.json"
      ]
    },
    {
      "Sid": "NotifyMissingBackup",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:eu-west-2:REPLACE_ACCOUNT_ID:REPLACE_TOPIC"
    }
  ]
}
